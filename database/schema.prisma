generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
}

enum SessionStatus {
  ACTIVE
  ENDED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  email           String               @unique
  passwordHash    String
  role            UserRole
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  classrooms      Classroom[]          @relation("ClassroomTeacher")
  enrollments     Enrollment[]
  attendance      AttendanceInterval[]
  chatMessages    ChatMessage[]
}

model Classroom {
  id          String        @id @default(uuid()) @db.Uuid
  teacherId   String        @db.Uuid
  title       String
  description String?
  inviteCode  String        @unique
  createdAt   DateTime      @default(now())
  teacher     User          @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([teacherId])
}

model Enrollment {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @db.Uuid
  userId      String    @db.Uuid
  enrolledAt  DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model ClassSession {
  id          String               @id @default(uuid()) @db.Uuid
  classroomId String               @db.Uuid
  roomName    String               @unique
  status      SessionStatus        @default(ACTIVE)
  startedAt   DateTime             @default(now())
  endedAt     DateTime?
  classroom   Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendance  AttendanceInterval[]
  messages    ChatMessage[]

  @@index([classroomId, status])
}

model AttendanceInterval {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  userId    String      @db.Uuid
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId, leftAt])
  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  userId    String      @db.Uuid
  content   String
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model WebhookEvent {
  id         String   @id @db.VarChar(128)
  eventType  String
  receivedAt DateTime @default(now())
  payload    Json

  @@index([eventType, receivedAt])
}
